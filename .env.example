# ============================================================
# Personal AI OS — 环境变量模板
#
# 用法：cp .env.example .env
# 说明：
#   1) .env 已被 .gitignore 忽略，请勿提交任何真实密钥。
#   2) .env 由 Docker Compose 自动读取；后端则以「同名系统环境变量」为准，
#      未设置时回落到 application.yml 中的默认值，因此开箱即可运行。
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=personal_ai_os
POSTGRES_USER=personalos
POSTGRES_PASSWORD=personalos
# 宿主机端口。默认 55432 以便避开本机常见的 5432 / 5433 占用；
# 容器内端口始终为 5432。
POSTGRES_PORT=55432

# ---- 后端 ----
SERVER_PORT=8080
# 后端读取数据库的主机名（容器外运行后端时用 localhost）
POSTGRES_HOST=localhost

# ---- 前端 ----
# 开发期由 Vite 代理 /api 到后端，通常无需修改
VITE_API_BASE_URL=/api/v1

# ============================================================
# 阶段 1 起才会用到的变量（此处预留，阶段 0 不生效）
# 请勿在此填入真实密钥，只在本地 .env 中填写
# ============================================================
# 大模型提供商：openai 兼容协议（可指向 DeepSeek / 通义 / 本地 Ollama 等）
# SPRING_AI_MODEL_PROVIDER=openai
# SPRING_AI_OPENAI_API_KEY=
# SPRING_AI_OPENAI_BASE_URL=https://api.openai.com
# SPRING_AI_OPENAI_CHAT_MODEL=gpt-4o-mini
# SPRING_AI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
