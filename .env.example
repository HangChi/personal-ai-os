# ============================================================
# Personal AI OS — 环境变量模板
#
# 用法：cp .env.example .env
# 说明：
#   1) .env 已被 .gitignore 忽略，请勿提交任何真实密钥。
#   2) .env 由 Docker Compose 自动读取；后端则以「同名系统环境变量」为准，
#      未设置时回落到 application.yml 中的默认值，因此开箱即可运行。
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=personal_ai_os
POSTGRES_USER=personalos
POSTGRES_PASSWORD=personalos
# 宿主机端口。默认 55432 以便避开本机常见的 5432 / 5433 占用；
# 容器内端口始终为 5432。
POSTGRES_PORT=55432

# ---- 后端 ----
SERVER_PORT=8080
# 后端读取数据库的主机名（容器外运行后端时用 localhost）
POSTGRES_HOST=localhost

# ---- 前端 ----
# 开发期由 Vite 代理 /api 到后端，通常无需修改
VITE_API_BASE_URL=/api/v1

# ============================================================
# 阶段 1 起生效：AI 模型配置
# ============================================================

# 聊天模型提供商：ollama（默认，本地无需密钥）| openai | none
AI_CHAT_PROVIDER=ollama

# 送给模型的上下文条数上限（不影响数据库中保存的完整历史）
AI_MEMORY_MAX_MESSAGES=20

# 送给模型的上下文**字符**预算（近似 token 预算，1 中文约 1.6 token）。
# 与上面的条数是两个维度：20 条各 4000 字约 8 万字，能直接撑爆模型窗口。
# 从最新消息往旧累加，超预算就整体停（不切半条消息）；最新一条无条件保留。
AI_MEMORY_MAX_CONTEXT_CHARS=12000

# 模型调用失败时的重试次数。默认 2 次（即最多尝试 2 回）。
# 默认的「多次重试 + 指数退避」会让模型不可达时客户端长时间停在无输出的流上，
# 因此这里显式收紧；调大能提高弱网下的成功率，但会拉长错误反馈时间。
AI_RETRY_MAX_ATTEMPTS=2

# 可选：自定义助手人设
# AI_SYSTEM_PROMPT=你是 Personal AI OS 的个人助手。回答简洁、准确，默认使用中文。

# ---- 本地 Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b

# ---- OpenAI 兼容服务（DeepSeek / 通义 / Kimi / 智谱 / vLLM 等）----
# 仅当 AI_CHAT_PROVIDER=openai 时才需要填 api-key
# ⚠️ 真实密钥只写在本机 .env，绝不提交
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini

# 思考型模型（如 DashScope qwen3.x）是否保留"先想再答"。
# false = 关闭思考，省 token 与等待。实测 qwen3.8-flash：
#   completion tokens 76 → 30（纯对话）、70 → 15（读图）；工具调用与读图能力均不受影响
#   端到端对话耗时约 2 秒
# ⚠️ 该字段是 DashScope 专有。改用官方 OpenAI / DeepSeek 等服务时，
#    仅改这个值为 true **不够**（参数仍会发出去，可能被拒），
#    必须把 application.yml 里 chat.options.extra-body 整段注释掉。
OPENAI_ENABLE_THINKING=false

# 示例：阿里云百炼 DashScope（OpenAI 兼容模式，chat 与 embedding 同一 base-url）
#   AI_CHAT_PROVIDER=openai
#   AI_EMBEDDING_PROVIDER=openai
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OPENAI_CHAT_MODEL=qwen3.8-flash            # 支持工具调用，也能读图
#   OPENAI_EMBEDDING_MODEL=qwen3.7-text-embedding-flash   # 默认输出 1024 维，与 vector(1024) 一致

# 其他可用模型（按需替换上面的 CHAT_MODEL）：
#   qwen3.8-flash · deepseek-v4-pro-0813 · deepseek-v4-flash-0731
#   ZHIPU/GLM-5.3 · ZHIPU/GLM-5.3-Flash · qwen3-omni-flash（多模态）
#
# 另外两个端点（本项目用不到，列出以备需要）：
#   Anthropic 兼容：https://dashscope.aliyuncs.com/apps/anthropic
#   原生嵌入：https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding

# ============================================================
# 阶段 3 起生效：知识库与嵌入模型
# ============================================================

# 嵌入模型提供商：ollama（默认，本地无需密钥）| openai | none
AI_EMBEDDING_PROVIDER=ollama

# 嵌入模型。默认 bge-m3，输出 1024 维 ——
# ⚠️ 该维度已写进 Flyway 迁移 V4 的 vector_store.embedding。
#    换模型前请先确认其输出维度，否则需新增迁移重建向量列。
OLLAMA_EMBEDDING_MODEL=bge-m3

# 当 AI_EMBEDDING_PROVIDER=openai 时使用的嵌入模型（走 OPENAI_BASE_URL）
# 例：qwen3.7-text-embedding-flash（1024 维）、text-embedding-3-small（1536 维，需改迁移）
OPENAI_EMBEDDING_MODEL=

# 嵌入维度（必须与迁移里的 vector(1024) 一致，否则启动失败）
AI_KNOWLEDGE_EMBEDDING_DIMENSIONS=1024

# 检索参数
AI_KNOWLEDGE_TOP_K=4
AI_KNOWLEDGE_SIMILARITY_THRESHOLD=0.3

# 单文件大小上限（字节），默认 5 MiB
AI_KNOWLEDGE_MAX_FILE_SIZE=5242880

# 允许上传的扩展名（逗号分隔）。新增类型需同时确认后端有对应的解析器，
# 否则文件能传上来却抽不出文字（入库会失败并提示）。
AI_KNOWLEDGE_ALLOWED_EXTENSIONS=md,markdown,txt,pdf,docx,png,jpg,jpeg,webp,gif

# ---- 分块（结构感知切分）----
# 目标块大小（字符）。切分尽量落在标题/段落边界，而不是按长度硬切。
AI_KNOWLEDGE_CHUNK_SIZE_CHARS=1200
# 相邻块重叠的字符数。0 = 不重叠（结构切分已在自然边界断开）。
AI_KNOWLEDGE_CHUNK_OVERLAP_CHARS=0
# 最小块字符数：低于它的块并入相邻块；也是入库前拒收过短文档的阈值。
# ⚠️ 用 mock 模型联调时文档往往很短，需要把它调到 50 以下。
AI_KNOWLEDGE_MIN_CHUNK_SIZE_CHARS=350

# ---- 混合检索（向量通道 + 关键词通道，RRF 融合）----
# 关掉即退回纯向量检索。保留开关是为了能 A/B 对比收益。
AI_KNOWLEDGE_HYBRID_ENABLED=true
# RRF 融合常数 k。越大，排名靠后的候选权重越小、融合越温和（60 是常用默认值）。
AI_KNOWLEDGE_RRF_K=60
# 关键词通道权重，相对向量通道（固定 1.0）。
# 实测结论：同权最好（1.0 时 R@1 86.0%，降到 0.5 反而只有 84.5%）——
# 噪声靠 IDF 抑制，不要靠整体降权。
AI_KNOWLEDGE_KEYWORD_CHANNEL_WEIGHT=1.0

# ============================================================
# 阶段 4 起生效：日程与提醒（定时扫描）
# ============================================================

# 定时扫描开关。界面之外的后台任务，关掉后不会产生任何提醒。
AI_CALENDAR_SCAN_ENABLED=true
# 扫描间隔与首次延迟（毫秒）。首次延迟是为了避开启动阶段抢数据库连接。
AI_CALENDAR_SCAN_INTERVAL_MS=60000
AI_CALENDAR_SCAN_INITIAL_DELAY_MS=10000
# 扫描窗口：向前看多远必须覆盖「提醒提前量」，否则到点的提醒会被漏掉；
# 向后看多远决定停机能补发多久以内的提醒（刻意只回看 24 小时，
# 补发一周前的提醒只会制造噪音，而不是「不丢数据」）。
AI_CALENDAR_SCAN_LOOKAHEAD=24h
AI_CALENDAR_SCAN_LOOKBACK=24h
# 新建日程时默认提前多久提醒（日程可逐个覆盖）。
AI_CALENDAR_DEFAULT_LEAD=15m
# 日程查询区间上限（天）与返回条数上限。
AI_CALENDAR_MAX_RANGE_DAYS=90
AI_CALENDAR_DEFAULT_QUERY_LIMIT=100
AI_CALENDAR_MAX_QUERY_LIMIT=500

# ============================================================
# 阶段 6 起生效：MCP 外部工具接入
# ============================================================

# MCP 总开关。默认不启用任何 server —— 「装了能力但没配置」与「配置前」行为一致。
# 每个 server 由 MCP_SERVERS_<名字>_* 一组变量定义（名字大写，如 FILESYSTEM）。
# ⚠️ 注意是复数 SERVERS：它与后端配置字段同名，写成单数 MCP_SERVER_* 会静默绑不上。
MCP_ENABLED=false

# ---- 示例：本地文件系统 server（只读工具自动放行，变更类需人工确认）----
# ⚠️ 安全第一道闸：ARGS 最后一个参数是该 server 允许访问的目录，
#    请限定到专用目录（如 ./mcp-sandbox），不要开放 home 或整个磁盘。
# 首次运行需联网下载 server 包（npx）。
# MCP_SERVERS_FILESYSTEM_COMMAND=npx
# MCP_SERVERS_FILESYSTEM_ARGS=-y,@modelcontextprotocol/server-filesystem,./mcp-sandbox
# MCP_SERVERS_FILESYSTEM_CONNECT_TIMEOUT=10s
# 策略为 AUTO（只读，直接执行）的工具清单；未列出的工具默认 CONFIRM（人工确认后执行）。
# MCP_SERVERS_FILESYSTEM_AUTO_TOOLS=read_file,read_text_file,read_media_file,read_multiple_files,list_directory,list_directory_with_sizes,directory_tree,search_files,get_file_info,list_allowed_directories

# ---- 需要密钥的 server：密钥只经环境变量透传给 server 子进程，绝不写入仓库或日志 ----
# MCP_SERVERS_GITHUB_COMMAND=npx
# MCP_SERVERS_GITHUB_ARGS=-y,@modelcontextprotocol/server-github
# MCP_SERVERS_GITHUB_ENV_GITHUB_TOKEN=${GITHUB_TOKEN}

# ============================================================
# 阶段 15 起生效：访问控制
# ============================================================

# 是否启用登录。默认关闭 —— 本地单用户 clone 下来就能跑。
# ⚠️ 对公网开放前必须设为 true，否则任何能连上端口的人都能读写你的全部数据。
AUTH_ENABLED=false

AUTH_USERNAME=admin

# 开启认证时必填。留空会让**应用启动失败**（刻意如此：
# 「起来了但谁都能进」比「起不来」更危险，因为你会以为自己开了认证）。
# 请使用足够长的随机密码；只写在本机 .env，绝不提交。
AUTH_PASSWORD=
