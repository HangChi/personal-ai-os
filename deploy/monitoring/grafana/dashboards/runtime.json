{
  "uid": "personalos-runtime",
  "title": "Personal AI OS 运行状态",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "活跃生成数",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "personalos_chat_streams_active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "首段正文 P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(personalos_chat_first_content_seconds_bucket[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "完整回复 P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(personalos_chat_duration_seconds_bucket[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "HTTP 请求速率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "连接池等待数",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "JVM 堆使用",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "重复嵌入观测比例",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(personalos_embedding_cache_requests_total{result=\"observed_repeat\"}[15m])) / sum(rate(personalos_embedding_cache_requests_total{result=~\"observed_.*\"}[15m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "嵌入缓存命中率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(personalos_embedding_cache_requests_total{result=\"hit\"}[15m])) / sum(rate(personalos_embedding_cache_requests_total{result=~\"hit|miss\"}[15m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "待处理索引任务",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "personalos_knowledge_jobs_pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "索引尝试结果",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(personalos_knowledge_jobs_attempts_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "RAG 阶段平均耗时",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, result) (rate(personalos_knowledge_rag_stage_seconds_sum[5m])) / sum by (stage, result) (rate(personalos_knowledge_rag_stage_seconds_count[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "RAG 证据状态",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(personalos_knowledge_rag_results_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "外部搜索待同步片段",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "personalos_knowledge_search_pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "外部搜索同步结果",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(personalos_knowledge_search_projections_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "RAG 辅助模型 Token",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(personalos_knowledge_rag_tokens_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "RAG 重排 Token",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(personalos_knowledge_rag_rerank_tokens_total[5m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "召回各环节 P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(personalos_knowledge_recall_seconds_bucket[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "title": "RAG 各阶段 P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(personalos_knowledge_rag_stage_seconds_bucket[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "title": "最早可执行任务等待时间",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (__name__) ({__name__=~\"personalos_knowledge_(jobs|review)_oldest_ready_seconds\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "独立 worker 采集状态",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "personalos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"personal-ai-os-worker\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
