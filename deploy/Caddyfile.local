# 宿主机 JAR 的本地静态前端；业务 API 保留原认证，管理端点不代理。
:80 {
    encode gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
    handle /api/* {
        reverse_proxy host.docker.internal:8080 {
            flush_interval -1
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
