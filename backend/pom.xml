<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot 4.1.1：Maven Central 上 4.1.x 线的最新稳定版（2026-08-20）。
      4.2.x 目前只有里程碑版，不作为基线。版本依据见
      specs/001-project-skeleton/research.md R-01。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.personalos</groupId>
    <artifactId>personal-ai-os-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>personal-ai-os-backend</name>
    <description>Personal AI OS 后端服务</description>

    <properties>
        <java.version>21</java.version>
        <!-- Spring AI 2.0.1：要求 Spring Boot 4.0.x / 4.1.x，与上方 parent 对齐 -->
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              只导入 Spring AI 的版本清单，不引入任何 spring-ai-starter-*。
              原因：模型 Starter 会要求 API Key，使骨架在无密钥时无法启动，
              与「开箱可跑」目标冲突。阶段 1 再按需引入。
              真实 artifact 名称见 research.md R-02。
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web：Spring Web MVC + 内嵌 Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 持久化 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 参数校验（Jakarta Bean Validation） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 健康检查 / 构建信息 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          访问控制（阶段 15）：单用户、会话 Cookie。

          为什么用 Spring Security 而不是手写一个认证过滤器：会话固定攻击、cookie 属性、
          过滤器顺序、注销时清理 SecurityContext —— 这些细节它已经做对了，重写只会更差。

          默认不启用（AUTH_ENABLED=false），全部请求放行，与阶段 14 行为一致。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
          数据库迁移：结构变更一律走 Flyway（宪法原则 IV）。

          注意（Boot 4 模块化实测结论）：Flyway 的自动配置已从
          spring-boot-autoconfigure 拆到独立模块 spring-boot-flyway。
          只引入 flyway-core 时，应用能启动但**迁移根本不执行**
          （flyway_schema_history 不生成、V1 的扩展未创建），
          因为检测不到 FlywayAutoConfiguration。必须使用本 starter。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ================= Spring AI 模型 ================= -->
        <!--
          阶段 1：两套模型 Starter 共存，用 spring.ai.model.chat 选择生效的一套
          （见 specs/002-ai-chat/research.md R-01）。
          - openai：靠 base-url 指向任意 OpenAI 兼容服务（DeepSeek/通义/Kimi/智谱/vLLM）
          - ollama：本地离线，无需密钥
          版本由上方 spring-ai-bom 统一管理。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <!--
          阶段 6：MCP 客户端（本地 stdio 接入外部工具 server）。
          标准 starter（JDK HttpClient/进程管道传输），与现有 Web MVC 同步栈匹配；
          webflux 变体是为远程 SSE 生产场景准备的，本轮用不到（research.md R-01）。
          spring-ai-starter-mcp-client:2.0.1 已核实存在于 Maven Central。
          版本由上方 spring-ai-bom 统一管理。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!--
          阶段 3：向量库。注意 artifact 名是 vector-store（带连字符），
          vectorstore 的拼写不存在（实测 404）。版本由上方 BOM 管理。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!--
          阶段 10：富文档解析（PDF 文本层 / docx / 图片走视觉模型）。
          - pdfbox 3.x：入口是 Loader.loadPDF（2.x 的 PDDocument.load 在 3.x 已移除）
          - poi-ooxml 5.x：只引这一块（docx 的 XWPF）；不引 poi-scratchpad，旧版 .doc 不做
          两者都不在 Spring AI BOM 管辖范围，因此版本显式写死（research R-01 / R-02 / R-06）。
          实测：pdfbox 3.0.5 与 poi-ooxml 5.5.1 均可从 Maven Central 拉取。
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.5</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>

        <!-- ================= 测试 ================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          注意：Testcontainers 2.x 起 artifact 更名为 testcontainers-<module>。
          旧名 org.testcontainers:postgresql / junit-jupiter 在 2.0.5 上已不存在（404）。
          类也从 org.testcontainers.containers.* 迁到 org.testcontainers.postgresql.*。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              覆盖率（2026-10-26 补）：只生成报告，**不设门禁**。

              为什么先不设 check goal：门禁需要一个经过论证的阈值，
              拍脑袋定 80% 只会逼着后来的人写无意义的断言去凑数。
              先让数字可见（target/site/jacoco/index.html），
              等到知道真实水位后再决定要不要卡。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
