# ============================================================
# Personal AI OS — .gitignore
# 注意：gitignore 不支持行内注释；说明必须独占一行并以 # 开头，
#       否则整条模式会失效（文件看似配好、实则未生效）。
# ============================================================

# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo

# ---- 环境变量 / 密钥 ----
.env
.env.*
!.env.example
*.pem
*.key
.secrets/

# ---- Java / Maven ----
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
!.mvn/wrapper/maven-wrapper.jar

# ---- Node / 前端 ----
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 日志 / 临时文件 ----
*.log
logs/
tmp/
.cache/

# ---- WorkBuddy 本地工作区数据 ----
.workbuddy/

# ---- 运行时数据目录 ----
/data/
/uploads/

# ---- Python 缓存（scripts/dev 下的开发脚本）----
__pycache__/
*.pyc

# ---- MCP 沙箱目录 ----
# 接入 filesystem server 时的示例目录（见 README 与 .env.example）。
# 它是**用户自己的文件区**，不是项目产物：里面放什么由用户决定，一律不入库。
/mcp-sandbox/
