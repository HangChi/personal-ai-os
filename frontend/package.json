{
  "name": "personal-ai-os-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal AI OS 前端（Vue 3 + TypeScript + Vite）",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test:logic": "node --import ./test/loader.mjs test/run.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"test/**/*.{mjs,ts}\" \"*.ts\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"test/**/*.{mjs,ts}\" \"*.ts\" \"*.js\"",
    "test:component": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.20.0",
    "dompurify": "^3.4.17",
    "element-plus": "^2.14.7",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
