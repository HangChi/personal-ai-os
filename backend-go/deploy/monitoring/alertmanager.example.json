{
  "global": {"resolve_timeout": "5m"},
  "route": {
    "receiver": "operator-webhook",
    "group_by": ["alertname", "job", "role"],
    "group_wait": "10s",
    "group_interval": "10s",
    "repeat_interval": "4h"
  },
  "receivers": [{
    "name": "operator-webhook",
    "webhook_configs": [{
      "url": "https://alerts.example.invalid/personal-ai-os",
      "send_resolved": true,
      "http_config": {"follow_redirects": false}
    }]
  }]
}
